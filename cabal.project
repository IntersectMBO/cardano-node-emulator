-- Custom repository for cardano haskell packages
-- See https://github.com/input-output-hk/cardano-haskell-packages on how to use CHaP in a Haskell project.
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

index-state:
  , hackage.haskell.org 2026-09-04T06:57:08Z
  , cardano-haskell-packages 2026-09-04T06:57:08Z

packages: plutus-ledger
          plutus-script-utils
          cardano-node-emulator
          cardano-node-socket-emulator
          freer-extras

constraints:
  , cardano-api == 11.7.0.0
  
-- quickcheck-state-machine-0.10.2 still caps `random <1.3`, but
-- ouroboros-consensus (pulled in transitively) now requires
-- `random ^>=1.3`. quickcheck-state-machine works fine with random
-- 1.3 in practice; its bounds are just stale, so relax them here
-- instead of waiting for an upstream bump.
allow-newer:
  , quickcheck-state-machine:random

-- We never, ever, want this.
write-ghc-environment-files: never

-- Only build tests and benchmarks for our own packages, not for
-- dependencies. Enabling tests/benchmarks globally forces cabal's
-- dependency solver to also satisfy the (often much stricter, and
-- sometimes conflicting) test-suite/benchmark dependency bounds of
-- every package in the plan, e.g. ouroboros-consensus's test-suites
-- pull in quickcheck-state-machine, which conflicts with the
-- `random` version required elsewhere.
tests: false
benchmarks: false

package plutus-ledger
  tests: true
  benchmarks: true
package plutus-script-utils
  tests: true
  benchmarks: true
package cardano-node-emulator
  tests: true
  benchmarks: true
package cardano-node-socket-emulator
  tests: true
  benchmarks: true
package freer-extras
  tests: true
  benchmarks: true

-- The only sensible test display option, since it allows us to have colourized
-- 'tasty' output.
test-show-details: direct

-- These packages appear in our dependency tree and are very slow to build.
-- Empirically, turning off optimization shaves off ~50% build time.
-- It also mildly improves recompilation avoidance.
-- For dev work we don't care about performance so much, so this is okay.
package cardano-ledger-alonzo
  optimization: False
package ouroboros-consensus
  optimization: False
package cardano-api
  optimization: False
package cardano-crypto-praos
  flags: -external-libsodium-vrf
