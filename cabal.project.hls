-- Project file used only by HLS/hie-bios (see hie.yaml), not by regular
-- `cabal build`. It layers editor-only GHC options on top of the normal
-- cabal.project.
--
-- Why this exists: the PlutusTx plugin compiles quoted `$$(compile [|| .. ||])`
-- terms and needs the GHC Core unfoldings of referenced INLINABLE bindings.
-- A normal `cabal build` gets these via `-fobject-code` plus the interface
-- pragma flags set in each package. HLS, however, loads modules with the
-- bytecode interpreter, where those unfoldings are absent, so the plugin fails
-- and (because of `-fplugin-opt PlutusTx.Plugin:defer-errors`) surfaces the
-- failures as editor-only diagnostics.
--
-- The fix (GHC 9.6+) is to have GHC persist the simplified Core into the
-- interface files and let the bytecode session restore it, which is exactly
-- what `-fwrite-if-simplified-core` + `-fprefer-byte-code` do.
-- Scope the options to our own packages only. HLS compiles just our source;
-- dependencies are loaded from their prebuilt artifacts, so a `package *`
-- stanza here would needlessly force a rebuild of the whole dependency tree on
-- first HLS load.
import: cabal.project

package plutus-ledger
  ghc-options: -fwrite-if-simplified-core -fprefer-byte-code
package plutus-script-utils
  ghc-options: -fwrite-if-simplified-core -fprefer-byte-code
package cardano-node-emulator
  ghc-options: -fwrite-if-simplified-core -fprefer-byte-code
package cardano-node-socket-emulator
  ghc-options: -fwrite-if-simplified-core -fprefer-byte-code
package freer-extras
  ghc-options: -fwrite-if-simplified-core -fprefer-byte-code
